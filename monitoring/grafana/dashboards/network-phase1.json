{
  "uid": "network-phase1",
  "title": "Network Monitoring - Phase 1",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Device Availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"snmp\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Interface Status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "2": {
                  "text": "Down",
                  "color": "red"
                },
                "3": {
                  "text": "Testing",
                  "color": "yellow"
                },
                "4": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "5": {
                  "text": "Dormant",
                  "color": "yellow"
                },
                "6": {
                  "text": "Not present",
                  "color": "gray"
                },
                "7": {
                  "text": "Lower layer down",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ifOperStatus",
          "legendFormat": "{{instance}} / {{ifIndex}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Interface Traffic In/Out",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ifHCInOctets[1m])*8",
          "legendFormat": "{{instance}} / {{ifIndex}} In",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ifHCOutOctets[1m])*8",
          "legendFormat": "{{instance}} / {{ifIndex}} Out",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "ICMP Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_duration_seconds{job=\"blackbox_icmp\"}*1000",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Probe Success Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(probe_success[5m])*100",
          "legendFormat": "{{instance}} / {{job}}",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
